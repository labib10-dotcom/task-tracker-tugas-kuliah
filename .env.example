# Salin file ini menjadi .env lalu isi dengan data asli kamu
# JANGAN pernah push file .env ke GitHub!

# ============================================
# KREDENSIAL E-LEARNING UNIVERSITAS TERBUKA
# ============================================
UT_NIM=masukkan_nim_anda_disini
UT_PASS=masukkan_password_elearning_anda_disini

# ============================================
# TELEGRAM BOT
# Cara dapat: chat @BotFather di Telegram → /newbot
# Chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
# ============================================
TELEGRAM_BOT_TOKEN=123456789:ABCDEF-token_bot_telegram_kamu
TELEGRAM_CHAT_ID=987654321

# ============================================
# NOTION
# Token: notion.so/my-integrations → New Integration
# Database ID: dari URL database notion kamu
#   contoh: notion.so/{DATABASE_ID}?v=...
# ============================================
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx